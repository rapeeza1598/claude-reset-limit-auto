# Generate with: claude setup-token
# Run on a machine already logged into your Claude Pro/Max account,
# approve the browser prompt, then paste the printed token below.
# Do NOT set ANTHROPIC_API_KEY anywhere in this project — it takes
# precedence over this token and would bill a separate API account
# instead of your subscription.
CLAUDE_CODE_OAUTH_TOKEN=

# Comma-separated hours (0-23), Asia/Bangkok time, at which to ping Claude.
# Edit this and run `docker compose restart` — no rebuild needed.
RESET_HOURS=6,11,16,21
